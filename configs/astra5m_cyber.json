{
  "model": {
    "vocab_size": 8192,
    "d_model": 256,
    "n_layers": 6,
    "n_heads": 8,
    "d_head": 32,
    "d_ffn": 512,
    "max_seq_len": 128,
    "rope_theta": 10000.0,
    "eps": 1e-6,
    "tie_embeddings": true
  },
  "training": {
    "max_steps": 2800,
    "peak_lr": 1.5e-4,
    "min_lr": 1e-5,
    "warmup_steps": 100,
    "batch_seq": 16,
    "accum_steps": 1,
    "optimizer": "adamw",
    "scheduler": "cosine",
    "weight_decay": 0.1,
    "grad_clip": 1.0,
    "val_every": 100,
    "save_every": 50,
    "val_shards": 1,
    "experiment_store": "experiments/runs"
  },
  "tokenizer": "tokenizer/artifacts/cyber_bpe.json",
  "data": {
    "train": "datasets/cyber/train.txt",
    "val": "datasets/cyber/val.txt"
  },
  "seed": 42,
  "out_dir": "checkpoints/astra5m_cyber",
  "safety": {
    "leak_check": false,
    "note": "cyber corpus row-level split: 0 shared ROW# ids and 0 duplicate alert bodies across train/val/eval (datasets/cyber/manifest.json). n=13 token-ngram overlap is a BPE artifact: ~112 bytes/token so 13 tokens span ~12 telemetry rows whose patterns repeat across independent rows."
  }
}