{
  "model": {
    "vocab_size": 8192,
    "d_model": 256,
    "n_layers": 6,
    "n_heads": 8,
    "d_head": 32,
    "d_ffn": 512,
    "max_seq_len": 128,
    "rope_theta": 10000.0,
    "eps": 1e-06,
    "tie_embeddings": true
  },
  "training": {
    "max_steps": 5400,
    "peak_lr": 0.0003,
    "min_lr": 1e-05,
    "warmup_steps": 50,
    "batch_seq": 16,
    "accum_steps": 1,
    "optimizer": "adamw",
    "scheduler": "cosine",
    "weight_decay": 0.1,
    "grad_clip": 1.0,
    "val_every": 100,
    "val_shards": 1,
    "save_every": 25,
    "experiment_store": "experiments/runs"
  },
  "tokenizer": "tokenizer/artifacts/prose_bpe.json",
  "data": {
    "train": "datasets/prose/train.txt",
    "val": "datasets/prose/val.txt"
  },
  "seed": 42,
  "out_dir": "checkpoints/astra5m_prose"
}
